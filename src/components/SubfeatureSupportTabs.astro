---
import type { Agent } from '../cms';
import Badge from './Badge.astro';

interface Props {
  subfeature: any;
  agents: Agent<any>[];
}

const { subfeature, agents } = Astro.props;

// Build agent data with per-agent status and content for this subfeature
const agentPanels = agents.map((agent) => {
  const status = subfeature.statusByAgent.get(agent.id) || subfeature.aggregatedStatus;
  const agentContent = subfeature.getAgentContent(agent.id);

  return {
    agent,
    status,
    content: agentContent,
  };
});

const defaultAgentId = agents[0]?.id || '';
---

<section class="tabbed-area">
  <div class="tab-list" role="tablist">
    {agentPanels.map((panel, index) => (
      <button
        class={`tab ${index === 0 ? 'tab-active' : ''}`}
        role="tab"
        aria-selected={index === 0 ? 'true' : 'false'}
        aria-controls={`panel-${panel.agent.id}`}
        data-agent-id={panel.agent.id}
        tabindex={index === 0 ? '0' : '-1'}
      >
        {panel.agent.name}
        <Badge status={panel.status} noText />
      </button>
    ))}
  </div>

  <div class="panels">
    {agentPanels.map((panel, index) => (
      <div
        id={`panel-${panel.agent.id}`}
        class={`panel ${index === 0 ? 'panel-active' : ''}`}
        role="tabpanel"
        aria-labelledby={`tab-${panel.agent.id}`}
        hidden={index !== 0}
      >
        {panel.content ? (
          <div class="agent-specific-content">
            <panel.content />
          </div>
        ) : (
          <p class="no-content">No additional details for this agent.</p>
        )}
      </div>
    ))}
  </div>
</section>

<style>
  .tabbed-area {
    display: flex;
    margin: 2rem 0;
    background-color: #ffffff;
    border: 1px solid var(--border-light);
  }

  .tab-list {
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--border-light);
    background-color: #f5f5f7;
    overflow-y: auto;
    scrollbar-width: thin;
    flex-shrink: 0;
  }

  .tab-list::-webkit-scrollbar {
    width: 4px;
  }

  .tab-list::-webkit-scrollbar-track {
    background: transparent;
  }

  .tab-list::-webkit-scrollbar-thumb {
    background: #d1d5db;
    border-radius: 2px;
  }

  .tab {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.25rem;
    background: none;
    border: none;
    border-left: 3px solid transparent;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-secondary);
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
    text-align: left;
  }

  .tab:hover {
    color: var(--text-primary);
    background-color: rgba(0, 0, 0, 0.02);
  }

  .tab:focus-visible {
    outline: 2px solid var(--main-feature-color);
    outline-offset: -2px;
  }

  .tab-active {
    color: var(--main-feature-color);
    border-left-color: var(--main-feature-color);
    background-color: #ffffff;
  }

  .panels {
    flex: 1;
    padding: 1.5rem;
    background-color: #ffffff;
    min-width: 0;
  }

  .panel {
    display: none;
    animation: fadeIn 0.2s ease;
  }

  .panel-active {
    display: block;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .no-content {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin: 0;
  }

  .agent-specific-content :global(p) {
    margin-bottom: 0.75rem;
    line-height: 1.6;
    color: var(--text-primary);
  }

  .agent-specific-content :global(h3) {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .agent-specific-content :global(code) {
    background-color: rgba(0, 0, 0, 0.05);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.9em;
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
  }

  .agent-specific-content :global(pre) {
    background-color: rgba(0, 0, 0, 0.05);
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 0.75rem 0;
  }

  .agent-specific-content :global(pre code) {
    background-color: transparent;
    padding: 0;
  }

  .agent-specific-content :global(ul),
  .agent-specific-content :global(ol) {
    margin-left: 1.25rem;
    margin-bottom: 0.75rem;
  }

  .agent-specific-content :global(li) {
    margin-bottom: 0.35rem;
    line-height: 1.6;
  }

  /* Responsive - stack vertically on mobile */
  @media (max-width: 600px) {
    .tabbed-area {
      flex-direction: column;
      margin: 1.5rem 0;
    }

    .tab-list {
      flex-direction: row;
      border-right: none;
      border-bottom: 1px solid var(--border-light);
      overflow-x: auto;
      overflow-y: hidden;
    }

    .tab-list::-webkit-scrollbar {
      height: 4px;
      width: auto;
    }

    .tab {
      border-left: none;
      border-bottom: 3px solid transparent;
      padding: 0.625rem 0.875rem;
      font-size: 0.8rem;
    }

    .tab-active {
      border-left-color: transparent;
      border-bottom-color: var(--main-feature-color);
    }

    .panels {
      padding: 1rem;
    }
  }
</style>

<script is:inline>
  (function() {
    const tabbedAreas = document.querySelectorAll('.tabbed-area');

    tabbedAreas.forEach((tabbedArea) => {
      const tabs = tabbedArea.querySelectorAll('.tab');
      const panels = tabbedArea.querySelectorAll('.panel');

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => {
          const agentId = tab.dataset.agentId;
          if (!agentId) return;

          tabs.forEach((t) => {
            t.classList.remove('tab-active');
            t.setAttribute('aria-selected', 'false');
            t.setAttribute('tabindex', '-1');
          });

          tab.classList.add('tab-active');
          tab.setAttribute('aria-selected', 'true');
          tab.setAttribute('tabindex', '0');

          panels.forEach((p) => {
            p.classList.remove('panel-active');
            p.hidden = true;
          });

          const activePanel = tabbedArea.querySelector(`#panel-${agentId}`);
          if (activePanel) {
            activePanel.classList.add('panel-active');
            activePanel.hidden = false;
          }
        });
      });

      tabs.forEach((tab) => {
        tab.addEventListener('keydown', (e) => {
          const currentIndex = Array.from(tabs).indexOf(tab);
          let nextIndex = currentIndex;

          if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
            e.preventDefault();
            nextIndex = (currentIndex + 1) % tabs.length;
            tabs[nextIndex].focus();
            tabs[nextIndex].click();
          } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
            e.preventDefault();
            nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
            tabs[nextIndex].focus();
            tabs[nextIndex].click();
          } else if (e.key === 'Home') {
            e.preventDefault();
            tabs[0].focus();
            tabs[0].click();
          } else if (e.key === 'End') {
            e.preventDefault();
            tabs[tabs.length - 1].focus();
            tabs[tabs.length - 1].click();
          }
        });
      });
    });
  })();
</script>
