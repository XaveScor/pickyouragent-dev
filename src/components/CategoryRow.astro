---
import type { Agent } from '../agents/featureSetSchema';
import { ParsedTable } from '../agents/parsedTable';
import StatusCell from './StatusCell.astro';
import SubscriptionsCell from './SubscriptionsCell.astro';

interface Props {
  feature: any;
  agents: Agent[];
}

const { feature, agents } = Astro.props;

const isSubscriptionsFeature = feature.getLinksByAgent !== undefined;
const lines = feature.getLines();
---

<tr class="category-row" data-category={feature.key} style={`--main-feature-color: ${feature.mainColor}; --secondary-feature-color: ${feature.secondaryColor}`}>
    <td class="category-cell">
      <a href={`/features/${feature.slug}`} class="category-name category-link">
        {lines[0]?.getDescription() || feature.name}
      </a>
    </td>
    {isSubscriptionsFeature && lines[0]?.getCells().map((cell: any) => (
      <td>
        <SubscriptionsCell links={cell.getProps().links} mainColor={cell.getProps().mainColor} />
      </td>
    ))}
    {!isSubscriptionsFeature && lines[0]?.getCells().map((cell: any) => (
      <td>
        <StatusCell status={cell.getProps().status} />
      </td>
    ))}
  </tr>
  {lines.slice(1).map((line: any) => (
    <tr class="feature-row" data-category={feature.key} style={`--main-feature-color: ${feature.mainColor}; --secondary-feature-color: ${feature.secondaryColor}`}>
      <td class="feature-cell">
        <a href={`/features/${feature.slug}#${line.getKey()}`} class="feature-name feature-link">
          {line.getDescription()}
        </a>
      </td>
      {line.getCells().map((cell: any) => (
        <td>
          <StatusCell status={cell.getProps().status} />
        </td>
      ))}
    </tr>
  ))}

<style>
  .category-row {
    border-top: 1px solid var(--border-light);
    background-color: color-mix(in srgb, var(--main-feature-color) 6%, transparent);
  }

  .category-row .category-cell,
  .feature-row .feature-cell {
    position: relative;
    padding-left: 1.75rem;
  }

  .category-row .category-cell::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 5px;
    background-color: var(--main-feature-color);
  }

  .feature-row .feature-cell::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background-color: var(--main-feature-color);
    opacity: 0.5;
  }

  .category-row td {
    padding: 1.1rem 1.25rem;
  }

  .category-name {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .feature-row td {
    padding: 0.5rem 1.25rem;
  }

  .feature-name {
    font-size: 0.82rem;
    color: var(--text-secondary);
    padding-left: 1.25rem;
  }

  @media (max-width: 900px) {
    .category-row td {
      padding: 0.9rem 0.75rem;
    }
    
    .feature-row td {
      padding: 0.4rem 0.75rem;
    }
  }

  @media (max-width: 600px) {
    .feature-name {
      padding-left: 0.75rem;
    }
    
    .category-row td {
      padding: 0.8rem 0.6rem;
    }
    
    .feature-row td {
      padding: 0.35rem 0.6rem;
    }
  }
</style>