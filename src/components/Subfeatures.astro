---
import type { ParsedFeature } from '../agents/parsedTable';

interface Props {
  feature: ParsedFeature;
}

const { feature } = Astro.props;

const subfeatures = feature.getSubfeatures();
---

{subfeatures.length > 0 && (
  <section class="subfeatures-list">
    {subfeatures.map((subfeature) => (
      <article class="subfeature-item" id={subfeature.key}>
        <h3 class="subfeature-title">{subfeature.name}</h3>
      </article>
    ))}
  </section>
)}

<style>
  .subfeatures-list {
    margin-top: 3rem;
  }

  .subfeature-item {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border-light);
  }

  .subfeature-item:last-child {
    border-bottom: none;
  }

  .subfeature-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
  }

  @media (max-width: 600px) {
    .subfeature-item {
      padding: 1rem 0;
    }

    .subfeature-title {
      font-size: 1.25rem;
    }
  }
</style>
