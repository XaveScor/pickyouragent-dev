---
import { Status } from './status';
import FeatureCell from './FeatureCell.astro';
import PointsBadge from '../../../components/PointsBadge.astro';

interface Props {
  name: string;
  mainColor: string;
  secondaryColor: string;
  slug: string;
  statuses: Array<Status>;
  weight: number;
}

const { name, mainColor, secondaryColor, slug, statuses, weight } = Astro.props;
---

<tr class="category-row" style={`--main-feature-color: ${mainColor}; --secondary-feature-color: ${secondaryColor}`}>
    <td class="category-cell">
      <a href={`/features/${slug}`} class="category-name category-link">
        {name}
      </a>
      <PointsBadge points={weight} />
    </td>
    {statuses.map((status) => {
      return (
        <td>
          <FeatureCell status={status} />
        </td>
      );
    })}
  </tr>
  <slot name="subfeatures" />

<style>
  .category-row {
    border-top: 1px solid var(--border-light);
    background-color: color-mix(in srgb, var(--main-feature-color) 6%, transparent);
  }

  .category-row .category-cell {
    position: relative;
    padding-left: 1.75rem;
  }

  .category-row .category-cell::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 5px;
    background-color: var(--main-feature-color);
  }

  .category-row td {
    padding: 1.1rem 1.25rem;
  }

  .category-name {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  @media (max-width: 900px) {
    .category-row td {
      padding: 0.9rem 0.75rem;
    }
  }

  @media (max-width: 600px) {
    .category-row td {
      padding: 0.8rem 0.6rem;
    }
  }
</style>
