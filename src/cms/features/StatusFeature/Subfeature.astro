---
import { Status } from "./status";
import FeatureCell from "./FeatureCell.astro";
import PointsBadge from "../../../components/PointsBadge.astro";
import InternalLink from "../../../components/InternalLink.astro";

interface Props {
  mainColor: string;
  secondaryColor: string;
  featureLink: string;
  slug: string;
  name: string;
  statuses: Array<Status>;
  weight: number;
}

const {featureLink, name, slug, secondaryColor, mainColor, statuses, weight} = Astro.props;
---

<tr class="feature-row" style={`--main-feature-color: ${mainColor}; --secondary-feature-color: ${secondaryColor}`}>
  <td class="feature-cell">
    <InternalLink href={`${featureLink}#${slug}`} class="feature-name" variant="subfeature">
      {name}
    </InternalLink>
    <PointsBadge points={weight} size="small" />
  </td>
  {statuses.map((status) => {
    return (
      <td>
        <FeatureCell status={status} />
      </td>
    );
  })}
</tr>

<style>
  .feature-row .feature-cell {
    position: relative;
    padding-left: 2.75rem;
  }

  .feature-row .feature-cell::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background-color: var(--main-feature-color);
    opacity: 0.5;
  }

  .feature-row td {
    padding: 0.5rem 1.25rem;
  }

  .feature-name {
    padding-left: 1.25rem;
  }

  @media (max-width: 900px) {
    .feature-row td {
      padding: 0.4rem 0.75rem;
    }
  }

  @media (max-width: 600px) {
    .feature-name {
      padding-left: 0.75rem;
    }

    .feature-row td {
      padding: 0.35rem 0.6rem;
    }
  }
</style>
