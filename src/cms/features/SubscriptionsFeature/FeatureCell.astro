---
import type { SubscriptionLink } from "./subscriptions";
import LinksList from "../../../components/LinksList.astro";
import Badge from "../../../components/Badge.astro";
import { Status } from "../StatusFeature/status";

interface Props {
  links: SubscriptionLink[];
  mainColor: string;
}

const { links, mainColor } = Astro.props;
---

{links.length > 0 ? (
  <LinksList links={links} mainColor={mainColor} />
) : <Badge status={Status.NotSupported} />}
