---
import type { SubscriptionService } from './subscriptions';
import SubscriptionServiceCard from '../../../components/SubscriptionServiceCard.astro';

interface Props {
  name: string;
  mainColor: string;
  agents: Array<{ agentId: string; agentName: string; links: SubscriptionService[] }>;
}

const { name, mainColor, agents } = Astro.props;

// Collect unique services and track which agents support each
const serviceMap = new Map<string, { service: SubscriptionService; supportedAgents: Array<{ id: string; name: string }> }>();
for (const agent of agents) {
  for (const service of agent.links) {
    if (!serviceMap.has(service.id)) {
      serviceMap.set(service.id, { service, supportedAgents: [] });
    }
    serviceMap.get(service.id)!.supportedAgents.push({ id: agent.agentId, name: agent.agentName });
  }
}
const servicesWithAgents = Array.from(serviceMap.values());
---

<section class="subscriptions-overview" style={`--main-feature-color: ${mainColor}`}>
  {servicesWithAgents.length > 0 ? (
    <div class="services-list">
      {servicesWithAgents.map(({ service, supportedAgents }) => (
        <SubscriptionServiceCard service={service} supportedAgents={supportedAgents} mainColor={mainColor} />
      ))}
    </div>
  ) : (
    <p class="no-services">No subscription services available.</p>
  )}
</section>

<style>
  .subscriptions-overview {
    margin: 2rem 0;
  }

  .services-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .no-services {
    color: var(--text-secondary);
    text-align: center;
    padding: 2rem;
  }
</style>
