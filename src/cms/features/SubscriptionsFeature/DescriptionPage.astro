---
import type { SubscriptionLink } from './subscriptions';
import Badge from '../../../components/Badge.astro';
import { Status } from '../StatusFeature/status';

interface Props {
  name: string;
  mainColor: string;
  agents: Array<{ agentId: string; agentName: string; links: SubscriptionLink[] }>;
}

const { name, mainColor, agents } = Astro.props;
---

<section class="subscriptions-tabs" style={`--main-feature-color: ${mainColor}`}>
  <div class="tab-list" role="tablist">
    {agents.map((agent, index) => (
      <button
        class={`tab ${index === 0 ? 'tab-active' : ''}`}
        role="tab"
        aria-selected={index === 0 ? 'true' : 'false'}
        aria-controls={`panel-${agent.agentId}`}
        data-agent-id={agent.agentId}
        tabindex={index === 0 ? '0' : '-1'}
      >
        {agent.agentName}
      </button>
    ))}
  </div>

  <div class="panels">
    {agents.map((agent, index) => (
      <div
        id={`panel-${agent.agentId}`}
        class={`panel ${index === 0 ? 'panel-active' : ''}`}
        role="tabpanel"
        hidden={index !== 0}
      >
        {agent.links.length > 0 ? (
          <div class="links-container">
            <ul class="links-list">
              {agent.links.map((link) => (
                <li>
                  <a href={link.url} target="_blank" rel="noopener noreferrer">
                    {link.label}
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                      <polyline points="15 3 21 3 21 9"></polyline>
                      <line x1="10" y1="14" x2="21" y2="3"></line>
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ) : (
          <div class="no-support">
            <Badge status={Status.NotSupported} />
          </div>
        )}
      </div>
    ))}
  </div>
</section>

<style>
  .subscriptions-tabs {
    margin: 2rem 0;
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid var(--border-light);
  }

  .tab-list {
    display: flex;
    border-bottom: 1px solid var(--border-light);
    background-color: #f5f5f7;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }

  .tab-list::-webkit-scrollbar {
    height: 4px;
  }

  .tab-list::-webkit-scrollbar-track {
    background: transparent;
  }

  .tab-list::-webkit-scrollbar-thumb {
    background: #d1d5db;
    border-radius: 2px;
  }

  .tab {
    padding: 0.875rem 1.25rem;
    background: none;
    border: none;
    border-bottom: 3px solid transparent;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-secondary);
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .tab:hover {
    color: var(--text-primary);
    background-color: rgba(0, 0, 0, 0.02);
  }

  .tab:focus-visible {
    outline: 2px solid var(--main-feature-color);
    outline-offset: -2px;
  }

  .tab-active {
    color: var(--main-feature-color);
    border-bottom-color: var(--main-feature-color);
    background-color: #ffffff;
  }

  .panels {
    padding: 1.5rem;
    background-color: #ffffff;
  }

  .panel {
    display: none;
    animation: fadeIn 0.2s ease;
  }

  .panel-active {
    display: block;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .links-container {
    padding: 0.5rem 0;
  }

  .links-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .links-list li a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--main-feature-color);
    text-decoration: none;
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .links-list li a:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  .links-list li a svg {
    flex-shrink: 0;
    opacity: 0.7;
  }

  .no-support {
    padding: 0.5rem 0;
  }

  @media (max-width: 900px) {
    .panels {
      padding: 1.25rem;
    }

    .tab {
      padding: 0.75rem 1rem;
      font-size: 0.85rem;
    }
  }

  @media (max-width: 600px) {
    .subscriptions-tabs {
      margin: 1.5rem 0;
      border-radius: 8px;
    }

    .panels {
      padding: 1rem;
    }

    .tab {
      padding: 0.625rem 0.875rem;
      font-size: 0.8rem;
    }
  }
</style>

<script is:inline>
  (function() {
    const tabbedAreas = document.querySelectorAll('.subscriptions-tabs');

    tabbedAreas.forEach((tabbedArea) => {
      const tabs = tabbedArea.querySelectorAll('.tab');
      const panels = tabbedArea.querySelectorAll('.panel');

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => {
          const agentId = tab.dataset.agentId;
          if (!agentId) return;

          tabs.forEach((t) => {
            t.classList.remove('tab-active');
            t.setAttribute('aria-selected', 'false');
            t.setAttribute('tabindex', '-1');
          });

          tab.classList.add('tab-active');
          tab.setAttribute('aria-selected', 'true');
          tab.setAttribute('tabindex', '0');

          panels.forEach((p) => {
            p.classList.remove('panel-active');
            p.hidden = true;
          });

          const activePanel = tabbedArea.querySelector(`#panel-${agentId}`);
          if (activePanel) {
            activePanel.classList.add('panel-active');
            activePanel.hidden = false;
          }
        });
      });

      tabs.forEach((tab) => {
        tab.addEventListener('keydown', (e) => {
          const currentIndex = Array.from(tabs).indexOf(tab);
          let nextIndex = currentIndex;

          if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
            e.preventDefault();
            nextIndex = (currentIndex + 1) % tabs.length;
            tabs[nextIndex].focus();
            tabs[nextIndex].click();
          } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
            e.preventDefault();
            nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
            tabs[nextIndex].focus();
            tabs[nextIndex].click();
          } else if (e.key === 'Home') {
            e.preventDefault();
            tabs[0].focus();
            tabs[0].click();
          } else if (e.key === 'End') {
            e.preventDefault();
            tabs[tabs.length - 1].focus();
            tabs[tabs.length - 1].click();
          }
        });
      });
    });
  })();
</script>
