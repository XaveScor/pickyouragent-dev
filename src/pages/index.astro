---
// Main comparison table page
import '../styles/global.css';
import type { Agent } from '../cms';
import { allAgents } from '../agents/allAgents';
import ComparisonTable from '../components/ComparisonTable.astro';
import Head from '../components/Head.astro';
import Navbar from '../components/Navbar.astro';

// Load all agents from allAgents.ts
const agents: Agent<any>[] = allAgents;
---

<html lang="en">
  <head>
    <Head 
      title="Pick Your Agent - Compare AI Coding Agents"
      description="A feature-by-feature comparison of AI coding agents for developers"
    />
  </head>
  <body>
    <Navbar />

    <main>
      <section class="hero">
        <h1>Pick your coding agent<br/>with confidence</h1>
        <p class="subtitle">A feature-by-feature comparison of AI coding agents for developers.</p>
      </section>
      
      <ComparisonTable agents={agents} />
    </main>
  </body>
</html>
