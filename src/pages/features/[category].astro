---
import { getCollection } from 'astro:content';
import '../../styles/global.css';
import { allAgents } from '../../agents/allAgents';
import { compileTable } from '../../agents/featureSetSchema';
import Head from '../../components/Head.astro';
import SubfeatureSupportTabs from '../../components/SubfeatureSupportTabs.astro';

export async function getStaticPaths() {
  const features = await getCollection('features');
  return features.map((entry) => ({
    params: { category: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;

const table = compileTable(allAgents);
const feature = await table.getFeature(entry.slug);

if (!feature) {
  return new Response('Feature not found', { status: 404 });
}

const mainColor = feature.mainColor || '#3b82f6';

const hasSubfeatures = typeof feature.getSubfeatures === 'function';
const subfeatures = hasSubfeatures ? feature.getSubfeatures() : [];

const agents = table.getAgents();
---

<html lang="en">
  <head>
    <Head
      title={`${entry.data.title} Features - Pick Your Agent`}
      description={entry.data.description}
    />
  </head>
  <body>
    <nav class="navbar">
      <a href="/" class="logo">pickyouragent.dev</a>
      <div class="nav-links">
        <a href="/about">About</a>
        <a href="/about#how-to-use">How to use</a>
      </div>
    </nav>

    <main class="feature-page">
      <a href="/" class="back-link">← Back to comparison</a>

      <article class="feature-content" style={`--main-feature-color: ${mainColor}`}>
        <h1>{entry.data.title}</h1>
        <p class="lead">{entry.data.description}</p>

        {subfeatures.length > 0 && (
          <>
            {subfeatures.map((subfeature: any) => (
              <section class="subfeature" id={subfeature.key}>
                <h2>{subfeature.name}</h2>
                <div class="subfeature-description">
                  {subfeature.Content && <subfeature.Content />}
                </div>
                <SubfeatureSupportTabs subfeature={subfeature} agents={agents} />
              </section>
            ))}
          </>
        )}
      </article>
    </main>
  </body>
</html>
